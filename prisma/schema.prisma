generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
  personalProfile TaxpayerProfile?
  memberships WorkspaceMember[]
  savingsGoals SavingsGoal[]
  taxVaults TaxVault[]
  @@map("user")
}
model SavingsGoal {
 id String @id @default(cuid())
 ownerId String
 owner User @relation(fields:[ownerId], references:[id], onDelete:Cascade)
 name String
 targetKobo Int
 targetDate DateTime
 frequency String
 preferredKobo Int?
 linkedAssessmentId String?
 provisional Boolean @default(false)
 importKey String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 contributions SavingsContribution[]
 revisions SavingsRevision[]
 @@unique([ownerId, importKey])
 @@index([ownerId])
 @@map("savings_goal")
}
model SavingsContribution {
 id String @id @default(cuid())
 goalId String
 goal SavingsGoal @relation(fields:[goalId], references:[id], onDelete:Cascade)
 amountKobo Int
 occurredAt DateTime
 note String?
 providerLabel String?
 source String @default("manual")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([goalId])
 @@map("savings_contribution")
}
model SavingsRevision {
 id String @id @default(cuid())
 goalId String
 goal SavingsGoal @relation(fields:[goalId], references:[id], onDelete:Cascade)
 previousKobo Int
 nextKobo Int
 reason String
 createdAt DateTime @default(now())
 @@index([goalId])
 @@map("savings_revision")
}
model TaxpayerProfile { id String @id @default(cuid())
 ownerId String @unique
 owner User @relation(fields:[ownerId], references:[id], onDelete:Cascade)
 legalType String @default("individual")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@map("taxpayer_profile")
}
model Workspace {
 id String @id @default(cuid())
 name String
 legalType String
 ownerId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 members WorkspaceMember[]
 @@map("workspace")
}
model WorkspaceMember {
 id String @id @default(cuid())
 workspaceId String
 userId String
 role String @default("owner")
 workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 @@unique([workspaceId,userId])
 @@index([userId])
 @@map("workspace_member")
}
model Session {
 id String @id
 expiresAt DateTime
 token String @unique
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 ipAddress String?
 userAgent String?
 userId String
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 @@index([userId])
 @@map("session")
}
model Account {
 id String @id
 accountId String
 providerId String
 userId String
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 accessToken String?
 refreshToken String?
 idToken String?
 accessTokenExpiresAt DateTime?
 refreshTokenExpiresAt DateTime?
 scope String?
 password String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([userId])
 @@map("account")
}
model Verification {
 id String @id
 identifier String
 value String
 expiresAt DateTime
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@map("verification")
}

// Tax vault: one per user per tax year. Money itself is held by the savings partner;
// these tables are Tax Dey's record of estimates and the partner's confirmations.
model TaxVault {
 id String @id @default(cuid())
 ownerId String
 owner User @relation(fields:[ownerId], references:[id], onDelete:Cascade)
 taxYear Int
 partnerId String
 profile Json?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 income VaultIncome[]
 moves VaultMove[]
 @@unique([ownerId, taxYear])
 @@map("tax_vault")
}
model VaultIncome {
 id String @id @default(cuid())
 vaultId String
 vault TaxVault @relation(fields:[vaultId], references:[id], onDelete:Cascade)
 receivedOn String
 amount Decimal @db.Decimal(18,2)
 source String
 setAside Decimal @db.Decimal(18,2)
 breakdown Json
 status String @default("pending")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([vaultId])
 @@map("vault_income")
}
// Append-only: rows are never updated or deleted by the app.
model VaultMove {
 id String @id @default(cuid())
 vaultId String
 vault TaxVault @relation(fields:[vaultId], references:[id], onDelete:Cascade)
 kind String
 amount Decimal @db.Decimal(18,2)
 incomeId String?
 partnerRef String
 note String?
 createdAt DateTime @default(now())
 @@unique([vaultId, incomeId])
 @@index([vaultId])
 @@map("vault_move")
}
